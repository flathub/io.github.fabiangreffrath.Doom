{
    "app-id": "io.github.fabiangreffrath.Doom",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "crispy-doom",
    "finish-args": [
        "--device=dri",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--share=network",
        "--socket=pulseaudio"
    ],
    "rename-icon": "crispy-doom",
    "modules": [
        {
            "name": "crispy-doom",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-bash-completion",
                "--disable-doc",
                "--disable-fonts",
                "--disable-icons"
            ],
            "post-install": [
                "mv /app/share/icons/hicolor/128x128/apps/crispy-setup.png /app/share/icons/hicolor/128x128/apps/${FLATPAK_ID}.Setup.png",
                "mv /app/share/icons/hicolor/128x128/apps/crispy-heretic.png /app/share/icons/hicolor/128x128/apps/${FLATPAK_ID}.Heretic.png",
                "mv /app/share/icons/hicolor/128x128/apps/crispy-hexen.png /app/share/icons/hicolor/128x128/apps/${FLATPAK_ID}.Hexen.png",
                "mv /app/share/icons/hicolor/128x128/apps/crispy-strife.png /app/share/icons/hicolor/128x128/apps/${FLATPAK_ID}.Strife.png",
                "mv /app/share/applications/io.github.fabiangreffrath.Setup.desktop /app/share/applications/${FLATPAK_ID}.Setup.desktop",
                "mv /app/share/applications/io.github.fabiangreffrath.Heretic.desktop /app/share/applications/${FLATPAK_ID}.Heretic.desktop",
                "mv /app/share/applications/io.github.fabiangreffrath.Hexen.desktop /app/share/applications/${FLATPAK_ID}.Hexen.desktop",
                "mv /app/share/applications/io.github.fabiangreffrath.Strife.desktop /app/share/applications/${FLATPAK_ID}.Strife.desktop",
                "desktop-file-edit --set-key=Exec --set-value=crispy-doom-setup /app/share/applications/${FLATPAK_ID}.Setup.desktop",
                "desktop-file-edit --set-icon=${FLATPAK_ID}.Setup /app/share/applications/${FLATPAK_ID}.Setup.desktop",
                "desktop-file-edit --set-icon=${FLATPAK_ID}.Heretic /app/share/applications/${FLATPAK_ID}.Heretic.desktop",
                "desktop-file-edit --set-icon=${FLATPAK_ID}.Hexen /app/share/applications/${FLATPAK_ID}.Hexen.desktop",
                "desktop-file-edit --set-icon=${FLATPAK_ID}.Strife /app/share/applications/${FLATPAK_ID}.Strife.desktop"
            ],
            "cleanup": [
                "/share/applications/screensavers",
                "/share/doc",
                "/share/metainfo/io.github.fabiangreffrath.Heretic.metainfo.xml",
                "/share/metainfo/io.github.fabiangreffrath.Hexen.metainfo.xml",
                "/share/metainfo/io.github.fabiangreffrath.Strife.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/fabiangreffrath/crispy-doom.git",
                    "tag": "crispy-doom-7.1",
                    "commit": "0a022e0ee6c74d9bab173ed9ee5212312e90ce3a"
                },
                {
                    "type": "patch",
                    "path": "metainfo.patch"
                }
            ]
        }
    ]
}
